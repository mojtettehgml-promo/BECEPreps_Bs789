{
  "name": "bece-prep-zone",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "bece-prep-zone", "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE" }
  ]
}
